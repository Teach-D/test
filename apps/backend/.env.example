# === 운영 환경 변수 (Render 배포 시 설정) ===

# 활성 프로필
SPRING_PROFILES_ACTIVE=prod

# 포트 (Render가 자동 제공)
PORT=8080

# 데이터베이스 (Neon PostgreSQL)
DATABASE_URL=jdbc:postgresql://<host>.neon.tech/roulette?sslmode=require
DB_USERNAME=roulette
DB_PASSWORD=your_password_here

# JWT 시크릿 키 (최소 256비트)
JWT_SECRET=your-jwt-secret-key-minimum-256-bits-long-here

# CORS 허용 도메인 (Vercel 배포 URL, 쉼표 구분)
CORS_ALLOWED_ORIGINS=https://your-web-user.vercel.app,https://your-web-admin.vercel.app
